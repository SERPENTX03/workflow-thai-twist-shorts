# Copy to .env and fill in. Never commit .env.
# ElevenLabs voices (voice ids that start with "eleven:"): create a key at https://elevenlabs.io/app/settings/api-keys
# (a restricted key needs "Text to Speech: Access"; add "Voices: Read" to look voices up by name).
ELEVENLABS_API_KEY=
# Gemini voices (voice ids that start with "gemini:"): https://aistudio.google.com/apikey
GEMINI_API_KEY=
