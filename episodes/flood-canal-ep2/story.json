  "shots": [
    { "scene": "call", "beats": 4, "style": "red", "text": "ตีสอง น้ำถึงวัด\nเหลืออีก [90 นาที]", "tone": "tense", "mood": 0.6, "cues": [[0, "hit"], [0.6, "tick"], [1.2, "tick"]] },
    { "scene": "call", "beats": 3, "text": "ภูมิรับสาย\nจากเบอร์ป้าแดง", "tone": "nervous", "mood": 0.6, "cues": [[0.4, "tick"]] },
    { "scene": "call", "beats": 4, "voice": "female", "text": "“ต้น… ใช่ต้นไหมลูก”", "tone": "whispers, trembling", "voLead": 0.4, "mood": 0.75, "cues": [[0, "shriek"]] },
    { "scene": "phone", "beats": 3, "text": "เบอร์นี้ เคยเป็นของ\n[ต้น] ลูกชายป้าแดง", "tone": "calm", "mood": 0.7, "cues": [[0.4, "whoosh"]], "vo": "เบอร์นี้ของต้น ลูกชายป้าแดง" },
    { "scene": "phone", "beats": 3, "text": "พอถูกยกเลิก\nก็{ขายต่อ}มาให้ภูมิ", "tone": "softly", "mood": 0.7 },
    { "scene": "battery", "beats": 4, "text": "กฎข้อ 4\n[ประหยัดแบต]ไว้ก่อน", "tone": "calm", "mood": 0.5, "cues": [[0.5, "stamp"]] },
    { "scene": "battery", "beats": 4, "text": "แบตเหลือ [31%]\nไฟดับ ชาร์จไม่ได้", "tone": "calm", "mood": 0.55, "cues": [[0.4, "tick"]] },
    { "scene": "battery", "beats": 3, "text": "เปิด[โหมดประหยัด]\nลดแสงหน้าจอ", "tone": "calm", "mood": 0.5, "cues": [[0.5, "tick"], [1.3, "tick"]] },
    { "scene": "battery", "beats": 3, "text": "ปิดเน็ต บลูทูธ\nที่ไม่ได้ใช้", "tone": "calm", "mood": 0.5, "cues": [[0.5, "tick"], [1.3, "tick"]] },
    { "scene": "neighbor", "beats": 4, "voice": "female", "text": "“ไปวัดสิลูก\nที่นั่น[ปลอดภัยที่สุด]”", "tone": "softly", "mood": 0.6, "cues": [[0.3, "creak"]] },
    { "scene": "neighbor", "beats": 5, "voice": "female", "text": "“แต่ตีสองน้ำจะมา\nปิด{ประตูหน้าศาลา}”", "tone": "softly", "mood": 0.7, "vo": "แต่ตีสองน้ำจะมาปิดประตูหน้าศาลา" },
    { "scene": "dog", "beats": 3, "text": "เจ้าโอ่งขนตั้ง\nทุกครั้งที่ป้าพูด", "tone": "nervous", "mood": 0.7, "cues": [[0, "hit"], [0.8, "shriek"]] },
    { "scene": "map", "beats": 3, "text": "ภูมิกับเจ้าโอ่ง\nขึ้นเรือ[พี่ชาติ]ไปวัด", "tone": "tense", "mood": 0.55, "cues": [[0.2, "whoosh"]] },
    { "scene": "temple", "beats": 4, "text": "ศาลาวัด\nคนหลบน้ำ [127 คน]", "mood": 0.55, "cues": [[0.4, "tick"], [1, "tick"]], "vo": "ศาลาวัด คนหลบน้ำ ร้อยยี่สิบเจ็ดคน" },
    { "scene": "temple", "beats": 4, "text": "บนเสาศาลา\n[บันทึกน้ำปี 54]", "tone": "curious", "mood": 0.6, "cues": [[0.4, "flip"]] },
    { "scene": "temple", "beats": 4, "text": "“14 ต.ค. 54 ตีสอง\nน้ำปิด{ประตูหน้า}”", "vo": "สิบสี่ ตุลา ห้าสิบสี่ ตีสอง น้ำปิดประตูหน้า", "tone": "tense", "mood": 0.75, "cues": [[0, "hit"]] },
    { "scene": "temple", "beats": 3, "text": "ตรงกับที่ป้าแดงบอก\n[ทุกตัวเลข]", "tone": "scared", "mood": 0.75 },
    { "scene": "generator", "beats": 3, "text": "แต่ในศาลา\nมี{เครื่องปั่นไฟ}ติดอยู่", "tone": "urgent", "mood": 0.65, "cues": [[0, "hit"]] },
    { "scene": "generator", "beats": 4, "text": "กฎข้อ 5\nปั่นไฟต้องอยู่[นอกอาคาร]", "tone": "urgent", "mood": 0.6, "cues": [[0.5, "stamp"]] },
    { "scene": "generator", "beats": 4, "text": "ควันมี {CO}\nไม่มีสี ไม่มีกลิ่น", "vo": "ควันมีคาร์บอนมอนอกไซด์ ไม่มีสี ไม่มีกลิ่น", "tone": "serious", "mood": 0.65, "cues": [[0.4, "whoosh"]] },
    { "scene": "generator", "beats": 3, "text": "ห่างประตู หน้าต่าง\nอย่างน้อย [6 เมตร]", "tone": "serious", "mood": 0.6, "cues": [[0.5, "tick"], [1.1, "tick"]] },
    { "scene": "exit", "beats": 3, "text": "ภูมิพาทุกคน\nย้ายไป[ประตูข้าง]", "tone": "urgent", "mood": 0.7, "cues": [[0.3, "step"], [1, "step"], [1.7, "step"]] },
    { "scene": "exit", "beats": 4, "text": "ตีสองตรง\nน้ำ{ปิดประตูหน้า}", "tone": "tense", "voLead": 0.4, "mood": 0.85, "cues": [[0, "hit"], [0.5, "whoosh"]] },
    { "scene": "exit", "beats": 3, "text": "ออกทางข้าง\nรอด[ครบทุกคน]", "tone": "relieved", "mood": 0.55, "cues": [[0.5, "bell"]] },
    { "scene": "roof", "beats": 4, "text": "แต่ฝั่งคลอง มี[แสงจอ]\nบนหลังคาบ้านป้า", "tone": "whispers", "mood": 0.8, "cues": [[0, "hit"], [1, "shriek"]] },
    { "scene": "roof", "beats": 4, "voice": "female", "text": "“ป้าอยู่บนหลังคา\nรอ[ต้น]โทรกลับ”", "tone": "sad", "voLead": 0.3, "mood": 0.8, "vo": "ป้ารอต้นโทรกลับ" },
    { "scene": "roof", "beats": 3, "text": "ไฟฉายที่เอวป้า\n{ไม่เคยเปิด}เลย", "tone": "whispers", "mood": 0.85 },
    { "scene": "dark", "beats": 4, "style": "red", "text": "ป้าแดง\n{ไม่เคยส่งสัญญาณ}", "tone": "whispers", "voLead": 0.5, "mood": 1, "cues": [[0, "bighit"]] },
    { "scene": "log", "beats": 4, "text": "บันทึกเรือปี 54\nบ้าน 14 [ไม่พบสัญญาณ]", "tone": "sad", "mood": 0.9, "cues": [[0.4, "flip"]] },
    { "scene": "signal", "beats": 4, "text": "กฎข้อ 6\nส่ง[สัญญาณ]ให้เรือเห็น", "tone": "urgent", "mood": 0.6, "cues": [[0.5, "stamp"]] },
    { "scene": "signal", "beats": 3, "text": "นกหวีด [3 ครั้ง]\nผ้าสีสด ไฟกะพริบ", "tone": "urgent", "mood": 0.6, "cues": [[0.4, "tick"], [0.8, "tick"], [1.2, "tick"]] },
    { "scene": "signal", "beats": 3, "text": "แล้วบอก[จุดที่อยู่]\nให้ชัดที่สุด", "tone": "calm", "mood": 0.6 },
    { "scene": "talk", "beats": 4, "text": "“แม่ ผมเอง[ต้น]\nเปิดไฟฉายที่เอวสิ”", "tone": "gently, emotional", "voLead": 0.3, "mood": 0.7, "music": true },
    { "scene": "flash", "beats": 3, "text": "ไฟบนหลังคา\n[กะพริบ]ครั้งแรก", "tone": "softly", "mood": 0.6, "music": true, "cues": [[0.4, "tick"], [0.8, "tick"], [1.2, "tick"]] },
    { "scene": "boat", "beats": 3, "text": "เรือพี่ชาติ\nเข้าไปถึงหลังคา", "tone": "softly", "mood": 0.55, "cues": [[0.2, "whoosh"]] },
    { "scene": "shadow", "beats": 4, "style": "red", "text": "ผิวน้ำใต้ป้าแดง\n{มีเงา}เป็นครั้งแรก", "tone": "whispers", "voLead": 0.4, "mood": 0.8, "cues": [[0, "hit"], [1, "bell"]] },
    { "scene": "shadow", "beats": 3, "text": "เจ้าโอ่ง\nเดินเข้าไปหาป้า", "tone": "softly, warm", "mood": 0.4, "music": true, "cues": [[0.3, "step"], [1, "step"]] },
    { "scene": "dawn", "beats": 4, "text": "เช้ามา บนหลังคา\nเหลือแค่[ไฟฉาย]", "tone": "softly", "mood": 0.45, "music": true },
    { "scene": "end", "beats": 4, "style": "red", "text": "สายที่ไม่ได้รับ\n[ต้น] · 14 ต.ค. 2554", "vo": "สายที่ไม่ได้รับ จากต้น ปีห้าสิบสี่", "tone": "whispers", "voLead": 0.3, "mood": 0.8, "cues": [[0, "tick"], [0.6, "tick"], [1.5, "shriek"]] }
  ]
