{
  "name": "thai-twist-shorts",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion workflow for Thai vertical twist-ending short stories",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts --port 3430",
    "typecheck": "tsc --noEmit",
    "check": "node scripts/check.mjs",
    "new": "node scripts/new-episode.mjs",
    "timeline": "node scripts/timeline.mjs",
    "voice": "node scripts/voice.mjs",
    "voices": "node scripts/voices.mjs",
    "voice-list": "node scripts/eleven_voices.mjs",
    "sfx": "node scripts/sfx.mjs",
    "score": "node scripts/score.mjs",
    "audio": "node scripts/audio.mjs",
    "fit": "node scripts/fit.mjs",
    "chapter": "node scripts/chapter.mjs",
    "story": "node scripts/story-check.mjs",
    "qc": "node scripts/qc.mjs",
    "gallery": "node scripts/gallery.mjs",
    "final": "node scripts/finalize.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.530",
    "@remotion/cli": "4.0.530",
    "@remotion/fonts": "4.0.530",
    "@remotion/renderer": "4.0.530",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@xmldom/xmldom": "^0.8.10",
    "typescript": "5.8.2"
  }
}
